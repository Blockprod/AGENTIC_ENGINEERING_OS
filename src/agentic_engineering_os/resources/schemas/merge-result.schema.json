{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering-os.local/schemas/merge-result.schema.json",
  "title": "Merge Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "workflow_generation",
    "wave_index",
    "group_index",
    "baseline_commit",
    "integration_order",
    "member_commits",
    "integration_commit",
    "primary_before",
    "primary_after",
    "result",
    "findings"
  ],
  "properties": {
    "mission_id": {"type": "string", "minLength": 1},
    "workflow_generation": {"type": "integer", "minimum": 0},
    "wave_index": {"type": "integer", "minimum": 0},
    "group_index": {"type": "integer", "minimum": 0},
    "baseline_commit": {"$ref": "#/$defs/commit"},
    "integration_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^US-[0-9]{4,}$"}
    },
    "member_commits": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/commit"}
    },
    "integration_commit": {
      "oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]
    },
    "primary_before": {"$ref": "#/$defs/commit"},
    "primary_after": {"$ref": "#/$defs/commit"},
    "result": {"enum": ["MERGED", "FAILED", "BLOCKED"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "summary", "members", "blocking"],
        "properties": {
          "code": {
            "enum": [
              "GATE_NOT_PASS",
              "STALE_INTEGRATION_GATE",
              "PRIMARY_DRIFT",
              "PRIMARY_DIRTY",
              "MEMBER_MISMATCH",
              "MEMBER_DRIFT",
              "TEMP_RESOURCE_DIVERGENCE",
              "GIT_MERGE_CONFLICT",
              "GIT_OPERATION_FAILED",
              "PROMOTION_FAILED",
              "FINAL_STATE_INVALID",
              "ALREADY_MERGED"
            ]
          },
          "summary": {"type": "string", "minLength": 1},
          "members": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "blocking": {"type": "boolean"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "MERGED"}}},
      "then": {"properties": {"integration_commit": {"$ref": "#/$defs/commit"}}}
    },
    {
      "if": {"properties": {"result": {"enum": ["FAILED", "BLOCKED"]}}},
      "then": {"properties": {"findings": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
