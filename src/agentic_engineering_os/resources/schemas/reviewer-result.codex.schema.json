{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "workflow_generation",
    "role",
    "subject",
    "user_story_id",
    "observed_commit",
    "summary",
    "dimensions_reviewed",
    "reviewed_paths",
    "findings",
    "blockers",
    "recommended_next_role",
    "verdict"
  ],
  "properties": {
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_generation": {
      "type": "integer",
      "minimum": 0
    },
    "role": {
      "enum": [
        "REVIEWER"
      ],
      "type": "string"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "user_story_id": {
      "type": "string",
      "pattern": "^US-[0-9]{4}$"
    },
    "observed_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "dimensions_reviewed": {
      "type": "array",
      "items": {
        "enum": [
          "SCOPE",
          "ARCHITECTURE",
          "MAINTAINABILITY",
          "COMPLEXITY",
          "DUPLICATION",
          "TEST_QUALITY",
          "CONTRACT_COMPLIANCE",
          "AUTHORITY_SAFETY"
        ],
        "type": "string"
      }
    },
    "reviewed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dimension",
          "severity",
          "summary",
          "evidence",
          "affected_paths",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "enum": [
              "SCOPE",
              "ARCHITECTURE",
              "MAINTAINABILITY",
              "COMPLEXITY",
              "DUPLICATION",
              "TEST_QUALITY",
              "CONTRACT_COMPLIANCE",
              "AUTHORITY_SAFETY"
            ],
            "type": "string"
          },
          "severity": {
            "enum": [
              "INFO",
              "MINOR",
              "MAJOR",
              "CRITICAL"
            ],
            "type": "string"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "affected_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_next_role": {
      "enum": [
        "ORCHESTRATOR",
        "ARCHITECT",
        "IMPLEMENTER",
        "TESTER",
        "REVIEWER",
        "CERTIFIER"
      ],
      "type": "string"
    },
    "verdict": {
      "enum": [
        "READY_FOR_CERTIFICATION",
        "REMEDIATION_REQUIRED",
        "BLOCKED"
      ],
      "type": "string"
    }
  }
}
