{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-engineering-os:schema:v1:wave-plan",
  "title": "Canonical V1 Prospective Logical Wave Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["waves", "deferred"],
  "properties": {
    "waves": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["wave_index", "members"],
        "properties": {
          "wave_index": {
            "type": "integer",
            "minimum": 0
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["user_story_id", "priority", "risk"],
              "properties": {
                "user_story_id": {
                  "type": "string",
                  "pattern": "^US-[0-9]{4}$"
                },
                "priority": {
                  "type": "integer",
                  "minimum": 1
                },
                "risk": {
                  "type": "string",
                  "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
                }
              }
            }
          }
        }
      }
    },
    "deferred": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user_story_id", "reason", "blocking_dependencies"],
        "properties": {
          "user_story_id": {
            "type": "string",
            "pattern": "^US-[0-9]{4}$"
          },
          "reason": {
            "type": "string",
            "enum": [
              "BLOCKED",
              "INELIGIBLE",
              "TERMINAL_SATISFIED",
              "TERMINAL_UNSATISFIED",
              "UNPLANNABLE_DEPENDENCY"
            ]
          },
          "blocking_dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^US-[0-9]{4}$"
            }
          }
        }
      }
    }
  }
}
