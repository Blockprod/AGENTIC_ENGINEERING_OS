{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-engineering-os:schema:v1:certification",
  "title": "Canonical V1 Certification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certification_id",
    "subject",
    "result",
    "commit",
    "acceptance_results",
    "gate_results",
    "human_approval",
    "evidence_refs",
    "certified_at",
    "certifier",
    "authorized_not_applicable_gates"
  ],
  "properties": {
    "certification_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "string",
      "enum": ["CERTIFIED", "REJECTED", "BLOCKED"]
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"
    },
    "acceptance_results": {
      "type": "object"
    },
    "gate_results": {
      "type": "object"
    },
    "human_approval": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "certified_at": {
      "type": "string",
      "format": "date-time"
    },
    "certifier": {
      "type": "string",
      "minLength": 1
    },
    "authorized_not_applicable_gates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
