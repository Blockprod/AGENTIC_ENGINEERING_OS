{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-engineering-os:schema:v1:certifier-result",
  "title": "Certifier Role Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "role", "subject", "user_story_id", "observed_commit", "summary", "artifact_checks", "acceptance_checks", "gate_checks", "evidence_refs", "human_approval_check", "findings", "blockers", "recommended_action", "verdict"],
  "properties": {
    "mission_id": {"type": "string", "minLength": 1},
    "role": {"const": "CERTIFIER"},
    "subject": {"type": "string", "minLength": 1},
    "user_story_id": {"type": "string", "pattern": "^US-[0-9]{4}$"},
    "observed_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "summary": {"type": "string", "minLength": 1},
    "artifact_checks": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/artifactCheck"}},
    "acceptance_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/acceptanceCheck"}},
    "gate_checks": {"type": "array", "items": {"$ref": "#/$defs/gateCheck"}},
    "evidence_refs": {"$ref": "#/$defs/stringArray"},
    "human_approval_check": {"$ref": "#/$defs/humanCheck"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "blockers": {"$ref": "#/$defs/stringArray"},
    "recommended_action": {"enum": ["SUBMIT_TO_CONTROL_PLANE", "RETURN_FOR_REMEDIATION", "RESOLVE_BLOCKERS"]},
    "verdict": {"enum": ["READY_FOR_CONTROL_PLANE", "REMEDIATION_REQUIRED", "BLOCKED"]}
  },
  "$defs": {
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "result": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]},
    "artifactCheck": {"type": "object", "additionalProperties": false, "required": ["artifact_role", "present", "coherent", "notes"], "properties": {"artifact_role": {"enum": ["ARCHITECT", "IMPLEMENTER", "TESTER", "REVIEWER"]}, "present": {"type": "boolean"}, "coherent": {"type": "boolean"}, "notes": {"type": "string", "minLength": 1}}},
    "acceptanceCheck": {"type": "object", "additionalProperties": false, "required": ["acceptance_criterion_id", "mandatory", "result", "evidence_refs", "notes"], "properties": {"acceptance_criterion_id": {"type": "string", "minLength": 1}, "mandatory": {"type": "boolean"}, "result": {"$ref": "#/$defs/result"}, "evidence_refs": {"$ref": "#/$defs/stringArray"}, "notes": {"type": "string", "minLength": 1}}},
    "gateCheck": {"type": "object", "additionalProperties": false, "required": ["gate_id", "present", "subject_matches", "result", "evidence_refs", "commit_matches", "not_applicable_authorized", "notes"], "properties": {"gate_id": {"type": "string", "minLength": 1}, "present": {"type": "boolean"}, "subject_matches": {"type": "boolean"}, "result": {"$ref": "#/$defs/result"}, "evidence_refs": {"$ref": "#/$defs/stringArray"}, "commit_matches": {"type": "boolean"}, "not_applicable_authorized": {"type": "boolean"}, "notes": {"type": "string", "minLength": 1}}},
    "humanCheck": {"type": "object", "additionalProperties": false, "required": ["required", "present", "valid", "evidence_ref", "notes"], "properties": {"required": {"type": "boolean"}, "present": {"type": "boolean"}, "valid": {"type": "boolean"}, "evidence_ref": {"type": ["string", "null"], "minLength": 1}, "notes": {"type": "string", "minLength": 1}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["code", "summary", "demonstrated_failure"], "properties": {"code": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}, "demonstrated_failure": {"type": "boolean"}}}
  },
  "allOf": [
    {"if": {"properties": {"verdict": {"const": "READY_FOR_CONTROL_PLANE"}}, "required": ["verdict"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "recommended_action": {"const": "SUBMIT_TO_CONTROL_PLANE"}}}},
    {"if": {"properties": {"verdict": {"const": "REMEDIATION_REQUIRED"}}, "required": ["verdict"]}, "then": {"properties": {"findings": {"minItems": 1}, "blockers": {"maxItems": 0}, "recommended_action": {"const": "RETURN_FOR_REMEDIATION"}}}},
    {"if": {"properties": {"verdict": {"const": "BLOCKED"}}, "required": ["verdict"]}, "then": {"properties": {"blockers": {"minItems": 1}, "recommended_action": {"const": "RESOLVE_BLOCKERS"}}}}
  ]
}
