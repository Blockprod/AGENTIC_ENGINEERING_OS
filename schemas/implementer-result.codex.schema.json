{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "workflow_generation",
    "role",
    "subject",
    "user_story_id",
    "observed_commit",
    "summary",
    "files_changed",
    "tests_added_or_modified",
    "verification_commands",
    "verification_results",
    "assumptions",
    "findings",
    "blockers",
    "recommended_next_role",
    "verdict"
  ],
  "properties": {
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_generation": {
      "type": "integer",
      "minimum": 0
    },
    "role": {
      "enum": [
        "IMPLEMENTER"
      ],
      "type": "string"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "user_story_id": {
      "type": "string",
      "pattern": "^US-[0-9]{4}$"
    },
    "observed_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests_added_or_modified": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "required",
          "result",
          "exit_code",
          "details"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "NOT_APPLICABLE"
            ],
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "details": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_next_role": {
      "enum": [
        "ORCHESTRATOR",
        "ARCHITECT",
        "IMPLEMENTER",
        "TESTER",
        "REVIEWER",
        "CERTIFIER"
      ],
      "type": "string"
    },
    "verdict": {
      "enum": [
        "READY_FOR_TEST",
        "BLOCKED"
      ],
      "type": "string"
    }
  }
}
