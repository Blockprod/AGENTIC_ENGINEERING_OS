{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-engineering-os:schema:v1:tester-result",
  "title": "Tester Role Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id", "role", "subject", "user_story_id", "observed_commit",
    "summary", "test_plan", "acceptance_results", "test_cases",
    "test_files_changed", "verification_commands", "verification_results",
    "findings", "blockers", "recommended_next_role", "verdict"
  ],
  "properties": {
    "mission_id": {"type": "string", "minLength": 1},
    "role": {"const": "TESTER"},
    "subject": {"type": "string", "minLength": 1},
    "user_story_id": {"type": "string", "pattern": "^US-[0-9]{4}$"},
    "observed_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "summary": {"type": "string", "minLength": 1},
    "test_plan": {"$ref": "#/$defs/testPlan"},
    "acceptance_results": {"type": "array", "items": {"$ref": "#/$defs/acceptanceResult"}},
    "test_cases": {"type": "array", "items": {"$ref": "#/$defs/testCase"}},
    "test_files_changed": {"$ref": "#/$defs/stringArray"},
    "verification_commands": {"$ref": "#/$defs/stringArray"},
    "verification_results": {"type": "array", "items": {"$ref": "#/$defs/verificationResult"}},
    "findings": {"$ref": "#/$defs/stringArray"},
    "blockers": {"$ref": "#/$defs/stringArray"},
    "recommended_next_role": {"enum": ["ORCHESTRATOR", "ARCHITECT", "IMPLEMENTER", "TESTER", "REVIEWER", "CERTIFIER"]},
    "verdict": {"enum": ["READY_FOR_REVIEW", "REMEDIATION_REQUIRED", "BLOCKED"]}
  },
  "$defs": {
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "plannedItems": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "result": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]},
    "testPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_criteria", "positive_tests", "negative_tests", "edge_cases", "regressions", "commands"],
      "properties": {
        "acceptance_criteria": {"$ref": "#/$defs/plannedItems"},
        "positive_tests": {"$ref": "#/$defs/plannedItems"},
        "negative_tests": {"$ref": "#/$defs/plannedItems"},
        "edge_cases": {"$ref": "#/$defs/plannedItems"},
        "regressions": {"$ref": "#/$defs/plannedItems"},
        "commands": {"$ref": "#/$defs/plannedItems"}
      }
    },
    "acceptanceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_criterion_id", "result", "evidence", "notes"],
      "properties": {
        "acceptance_criterion_id": {"type": "string", "minLength": 1},
        "result": {"$ref": "#/$defs/result"},
        "evidence": {"$ref": "#/$defs/stringArray"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "objective", "expected_result", "observed_result", "required", "executed", "verdict"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["POSITIVE", "NEGATIVE", "EDGE", "REGRESSION"]},
        "objective": {"type": "string", "minLength": 1},
        "expected_result": {"type": "string", "minLength": 1},
        "observed_result": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "executed": {"type": "boolean"},
        "verdict": {"$ref": "#/$defs/result"}
      }
    },
    "verificationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "required", "executed", "result", "exit_code", "details"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "executed": {"type": "boolean"},
        "result": {"$ref": "#/$defs/result"},
        "exit_code": {"type": ["integer", "null"]},
        "details": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]}, "then": {"properties": {"executed": {"const": true}, "exit_code": {"const": 0}}}},
        {"if": {"properties": {"result": {"const": "FAIL"}}, "required": ["result"]}, "then": {"properties": {"executed": {"const": true}, "exit_code": {"type": "integer", "not": {"const": 0}}}}},
        {"if": {"properties": {"result": {"enum": ["UNKNOWN", "NOT_APPLICABLE"]}}, "required": ["result"]}, "then": {"properties": {"exit_code": {"type": "null"}}}}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "READY_FOR_REVIEW"}}, "required": ["verdict"]},
      "then": {"properties": {"acceptance_results": {"minItems": 1}, "test_cases": {"minItems": 1}, "verification_commands": {"minItems": 1}, "verification_results": {"minItems": 1}, "blockers": {"maxItems": 0}, "recommended_next_role": {"const": "REVIEWER"}}}
    },
    {
      "if": {"properties": {"verdict": {"const": "REMEDIATION_REQUIRED"}}, "required": ["verdict"]},
      "then": {"properties": {"findings": {"minItems": 1}, "blockers": {"maxItems": 0}, "recommended_next_role": {"const": "IMPLEMENTER"}}}
    },
    {
      "if": {"properties": {"verdict": {"const": "BLOCKED"}}, "required": ["verdict"]},
      "then": {"properties": {"blockers": {"minItems": 1}, "recommended_next_role": {"const": "ORCHESTRATOR"}}}
    }
  ]
}
