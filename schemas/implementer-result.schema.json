{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-engineering-os:schema:v1:implementer-result",
  "title": "Implementer Role Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id", "workflow_generation", "role", "subject", "user_story_id", "observed_commit",
    "summary", "files_changed", "tests_added_or_modified",
    "verification_commands", "verification_results", "assumptions", "findings",
    "blockers", "recommended_next_role", "verdict"
  ],
  "properties": {
    "mission_id": {"type": "string", "minLength": 1},
    "workflow_generation": {"type": "integer", "minimum": 0},
    "role": {"const": "IMPLEMENTER"},
    "subject": {"type": "string", "minLength": 1},
    "user_story_id": {"type": "string", "pattern": "^US-[0-9]{4}$"},
    "observed_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "summary": {"type": "string", "minLength": 1},
    "files_changed": {"$ref": "#/$defs/stringArray"},
    "tests_added_or_modified": {"$ref": "#/$defs/stringArray"},
    "verification_commands": {"$ref": "#/$defs/stringArray"},
    "verification_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/verificationResult"}
    },
    "assumptions": {"$ref": "#/$defs/stringArray"},
    "findings": {"$ref": "#/$defs/stringArray"},
    "blockers": {"$ref": "#/$defs/stringArray"},
    "recommended_next_role": {
      "enum": ["ORCHESTRATOR", "ARCHITECT", "IMPLEMENTER", "TESTER", "REVIEWER", "CERTIFIER"]
    },
    "verdict": {"enum": ["READY_FOR_TEST", "BLOCKED"]}
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "verificationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "required", "result", "exit_code", "details"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "result": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]},
        "exit_code": {"type": ["integer", "null"]},
        "details": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"result": {"const": "PASS"}}, "required": ["result"]},
          "then": {"properties": {"exit_code": {"const": 0}}}
        },
        {
          "if": {"properties": {"result": {"const": "FAIL"}}, "required": ["result"]},
          "then": {"properties": {"exit_code": {"type": "integer", "not": {"const": 0}}}}
        },
        {
          "if": {"properties": {"result": {"enum": ["UNKNOWN", "NOT_APPLICABLE"]}}, "required": ["result"]},
          "then": {"properties": {"exit_code": {"type": "null"}}}
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "READY_FOR_TEST"}}, "required": ["verdict"]},
      "then": {
        "properties": {
          "files_changed": {"minItems": 1},
          "verification_commands": {"minItems": 1},
          "verification_results": {"minItems": 1},
          "blockers": {"maxItems": 0},
          "recommended_next_role": {"const": "TESTER"}
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "BLOCKED"}}, "required": ["verdict"]},
      "then": {
        "properties": {
          "blockers": {"minItems": 1},
          "recommended_next_role": {"const": "ORCHESTRATOR"}
        }
      }
    }
  ]
}
