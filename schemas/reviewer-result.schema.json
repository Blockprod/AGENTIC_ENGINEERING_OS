{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-engineering-os:schema:v1:reviewer-result",
  "title": "Reviewer Role Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id", "role", "subject", "user_story_id", "observed_commit",
    "summary", "dimensions_reviewed", "reviewed_paths", "findings", "blockers",
    "recommended_next_role", "verdict"
  ],
  "properties": {
    "mission_id": {"type": "string", "minLength": 1},
    "role": {"const": "REVIEWER"},
    "subject": {"type": "string", "minLength": 1},
    "user_story_id": {"type": "string", "pattern": "^US-[0-9]{4}$"},
    "observed_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "summary": {"type": "string", "minLength": 1},
    "dimensions_reviewed": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["SCOPE", "ARCHITECTURE", "MAINTAINABILITY", "COMPLEXITY", "DUPLICATION", "TEST_QUALITY", "CONTRACT_COMPLIANCE", "AUTHORITY_SAFETY"]}
    },
    "reviewed_paths": {"$ref": "#/$defs/pathArray"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "blockers": {"$ref": "#/$defs/stringArray"},
    "recommended_next_role": {"enum": ["ORCHESTRATOR", "ARCHITECT", "IMPLEMENTER", "TESTER", "REVIEWER", "CERTIFIER"]},
    "verdict": {"enum": ["READY_FOR_CERTIFICATION", "REMEDIATION_REQUIRED", "BLOCKED"]}
  },
  "$defs": {
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "pathArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dimension", "severity", "summary", "evidence", "affected_paths", "blocking"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "dimension": {"enum": ["SCOPE", "ARCHITECTURE", "MAINTAINABILITY", "COMPLEXITY", "DUPLICATION", "TEST_QUALITY", "CONTRACT_COMPLIANCE", "AUTHORITY_SAFETY"]},
        "severity": {"enum": ["INFO", "MINOR", "MAJOR", "CRITICAL"]},
        "summary": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "affected_paths": {"$ref": "#/$defs/pathArray", "minItems": 1},
        "blocking": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "READY_FOR_CERTIFICATION"}}, "required": ["verdict"]},
      "then": {"properties": {"dimensions_reviewed": {"minItems": 8}, "reviewed_paths": {"minItems": 1}, "blockers": {"maxItems": 0}, "recommended_next_role": {"const": "CERTIFIER"}}}
    },
    {
      "if": {"properties": {"verdict": {"const": "REMEDIATION_REQUIRED"}}, "required": ["verdict"]},
      "then": {"properties": {"findings": {"minItems": 1}, "blockers": {"maxItems": 0}, "recommended_next_role": {"const": "IMPLEMENTER"}}}
    },
    {
      "if": {"properties": {"verdict": {"const": "BLOCKED"}}, "required": ["verdict"]},
      "then": {"properties": {"blockers": {"minItems": 1}, "recommended_next_role": {"const": "ORCHESTRATOR"}}}
    }
  ]
}
