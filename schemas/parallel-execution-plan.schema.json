{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineering-os.local/schemas/parallel-execution-plan.schema.json",
  "title": "Parallel Execution Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "workflow_generation",
    "baseline_commit",
    "wave_index",
    "groups",
    "source_fingerprint"
  ],
  "properties": {
    "mission_id": {"type": "string", "minLength": 1},
    "workflow_generation": {"type": "integer", "minimum": 0},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "wave_index": {"type": "integer", "minimum": 0},
    "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_index", "wave_index", "user_story_ids"],
        "properties": {
          "group_index": {"type": "integer", "minimum": 0},
          "wave_index": {"type": "integer", "minimum": 0},
          "user_story_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^US-[0-9]{4,}$"}
          }
        }
      }
    }
  }
}
