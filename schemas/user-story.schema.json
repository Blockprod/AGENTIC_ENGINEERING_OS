{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-engineering-os:schema:v1:user-story",
  "title": "Canonical V1 User Story",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "description",
    "status",
    "priority",
    "risk",
    "depends_on",
    "scope",
    "acceptance_criteria",
    "required_gates",
    "human_approval",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^US-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "PLANNED",
        "BLOCKED",
        "READY",
        "IN_PROGRESS",
        "IMPLEMENTED",
        "TESTING",
        "REVIEW",
        "CERTIFICATION",
        "CERTIFIED",
        "REJECTED",
        "REMEDIATION_REQUIRED",
        "CANCELLED"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 1
    },
    "risk": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^US-[0-9]{4}$"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "forbidden_paths"],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "mandatory"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "mandatory": {
            "type": "boolean"
          }
        }
      }
    },
    "required_gates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "approved",
        "approved_by",
        "approved_at",
        "evidence_ref"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "approved": {
          "type": "boolean"
        },
        "approved_by": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "approved_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "evidence_ref": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "created_by", "updated_at"],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
